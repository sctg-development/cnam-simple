{
    "name": "cnam-simple-client",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:env": "bash -c 'set -a && source ../../.env && set +a && vite'",
        "build": "yarn clean && vite build",
        "build:env": "bash -c 'yarn clean && set -a && source ../../.env && set +a && vite build \"$@\" && yarn copy:printpdf' --",
        "copy:printpdf": "bash -lc 'mkdir -p src/printpdf && cp -v ../../libs/printpdf/pkg/printpdf.js ../../libs/printpdf/pkg/printpdf_bg.wasm ../../libs/printpdf/pkg/printpdf.d.ts ../../libs/printpdf/pkg/printpdf_bg.wasm.d.ts src/printpdf/ || true'",
        "lint": "eslint ./src/**/**/*.{ts,tsx} --fix",
        "type-check": "tsc --noEmit",
        "preview:env": "bash ./scripts/preview-ensure.sh",
        "clean": "rm -rf dist .turbo node_modules/.vite node_modules/.cache"
    },
    "dependencies": {
        "@heroui/button": "^2.2.31",
        "@heroui/code": "^2.2.24",
        "@heroui/dropdown": "^2.3.31",
        "@heroui/input": "^2.4.32",
        "@heroui/kbd": "^2.2.25",
        "@heroui/link": "2.2.20",
        "@heroui/modal": "^2.2.28",
        "@heroui/navbar": "^2.2.29",
        "@heroui/shared-utils": "^2.1.12",
        "@heroui/snippet": "^2.2.32",
        "@heroui/switch": "^2.2.26",
        "@heroui/system": "^2.4.27",
        "@heroui/theme": "^2.4.26",
        "@heroui/tooltip": "^2.2.28",
        "@maddyguthridge/marked-mermaid": "^0.1.2",
        "@react-aria/visually-hidden": "3.8.30",
        "@react-types/shared": "^3.33.0",
        "@tailwindcss/postcss": "^4.1.18",
        "axios": "^1.13.5",
        "color-name": "^2.1.0",
        "dompurify": "^3.3.1",
        "framer-motion": "^12.34.0",
        "highlight.js": "^11.11.1",
        "html-entities": "^2.6.0",
        "html-minifier-terser": "^7.2.0",
        "htmlparser2": "^10.1.0",
        "i18next": "^25.8.10",
        "i18next-http-backend": "^3.0.2",
        "image-size": "^2.0.2",
        "jszip": "^3.10.1",
        "lodash": "^4.17.23",
        "lru-cache": "^11.2.6",
        "marked": "^17.0.2",
        "marked-highlight": "^2.2.3",
        "mime-types": "^3.0.2",
        "nanoid": "^5.1.6",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-i18next": "^16.5.4",
        "react-router-dom": "^7.13.0",
        "tailwind-variants": "^3.2.2",
        "tailwindcss": "^4.1.18",
        "xmlbuilder2": "2.1.2"
    },
    "devDependencies": {
        "@sctg/vite-plugin-github-pages-spa": "^0.1.1",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.1.18",
        "@types/color-name": "^2",
        "@types/html-minifier-terser": "^7",
        "@types/lodash": "^4",
        "@types/mime-types": "^3",
        "@types/node": "^24.10.12",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.55.0",
        "@typescript-eslint/parser": "^8.56.0",
        "@vitejs/plugin-react": "^5.1.4",
        "autoprefixer": "^10.4.24",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-node": "^11.1.0",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.3.0",
        "jiti": "^2.6.1",
        "postcss": "^8.5.6",
        "prettier": "^3.8.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vite-plugin-node-polyfills": "^0.25.0",
        "vite-tsconfig-paths": "^6.1.1"
    }
}
