{
    "name": "cnam-simple-worker",
    "version": "0.0.0",
    "type": "module",
    "license": "MIT",
    "packageManager": "yarn@4.12.0",
    "scripts": {
        "deploy": "wrangler deploy",
        "dev": "wrangler dev",
        "dev:env": "bash -c 'cp ../../.env .dev.vars && wrangler dev'",
        "preview:env": "bash -c 'cp ../../.env .dev.vars && wrangler dev --port 8787'",
        "start": "wrangler dev",
        "build": "echo 'Cloudflare Worker does not require build step'",
        "test": "vitest",
        "type-check": "tsc --noEmit",
        "lint": "eslint ./src/**/*.{ts,tsx} --fix",
        "clean": "rm -rf .wrangler .dev.vars .turbo",
        "cf-typegen": "wrangler types",
        "cf-typegen:env": "bash -c 'cp ../../.env .dev.vars && wrangler types'"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "^0.12.10",
        "@cloudflare/workers-types": "^4.20260207.0",
        "@types/node": "^24.10.11",
        "@typescript-eslint/eslint-plugin": "^8.54.0",
        "@typescript-eslint/parser": "^8.54.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-node": "^11.1.0",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-unused-imports": "^4.3.0",
        "jiti": "^2.6.1",
        "typescript": "^5.9.3",
        "vitest": "~3.2.4",
        "wrangler": "^4.63.0"
    },
    "dependencies": {
        "@cloudflare/playwright": "^1.1.0",
        "jose": "^6.1.3",
        "sha512crypt-node": "^1.0.2"
    }
}
